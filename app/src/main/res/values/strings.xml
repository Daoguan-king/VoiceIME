    <!-- 首次启用引导 -->
    <string name="onboard_title">Welcome to VoiceIME</string>
    <string name="onboard_intro">A minimal local voice input IME powered by sherpa-onnx SenseVoice. Four quick steps to get it working with Trime (同文输入法):</string>
    <string name="step_ime_title">1. Enable this IME in system settings</string>
    <string name="step_ime_desc">Settings → System → Languages &amp; input → On-screen keyboard → enable VoiceIME. Trime only finds enabled IMEs.</string>
    <string name="btn_open_ime_settings">Open system IME settings</string>
    <string name="step_mic_title">2. Grant microphone permission</string>
    <string name="step_mic_desc">Recording happens locally on this device.</string>
    <string name="btn_grant_mic">Grant permission</string>
    <string name="step_model_title">3. Download the SenseVoice model</string>
    <string name="step_model_desc">About 170 MB for the int8 model, stored in the app private directory.</string>
    <string name="btn_download_model">Download model</string>
    <string name="step_trime_title">4. Configure Trime (同文输入法)</string>
    <string name="step_trime_desc">In Trime: Settings → General → Preferred voice input → select VoiceIME. Then press the voice key on the keyboard (usually long-press space or the ✾ key, bound to VOICE_ASSIST in your theme).</string>
    <string name="btn_start_use">Got it, start using</string>

