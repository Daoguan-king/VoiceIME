<?xml version="1.0" encoding="utf-8"?>
<!--
  语音识别面板（UI 设计师 design-ui-designer 方案）：
  暗色渐变圆角卡片 + 电平动画 + 大号胶囊按钮 + 语言芯片 + 底部手势安全区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- 状态 / 实时识别预览文字 -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="3"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- 录音电平动画 -->
    <com.voiceime.LevelView
        android:id="@+id/level_view"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <!-- 大按钮：开始 / 结束 -->
    <Button
        android:id="@+id/mic_button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_mic_bg"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_start"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- 语言快捷切换 -->
    <Button
        android:id="@+id/lang_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_lang_bg"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@null"
        android:text="🌐 自动"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
